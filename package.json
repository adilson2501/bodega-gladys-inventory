{
  "name": "bodega-gladys-inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "node scripts/dev-staging.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify:production": "node scripts/production-db.mjs",
    "db:verify:staging": "node scripts/verify-staging-db.mjs",
    "db:reset:staging": "node scripts/reset-staging-commercial-data.mjs",
    "db:migrate:staging": "node scripts/migrate-staging-db.mjs",
    "db:inspect:staging": "node scripts/inspect-staging-db.mjs",
    "db:migrate:staging:direct": "node scripts/migrate-staging-direct.mjs",
    "db:migrate:staging:preflight": "node scripts/migrate-staging-direct.mjs --dry-run",
    "db:test:staging": "node scripts/test-staging-integration.mjs",
    "test:integration:resolution": "node scripts/check-integration-import.mjs",
    "ml:test": "pytest ml/tests",
    "ml:test:service": "pytest python/tests",
    "ml:simulate": "python3 -m ml.simulate_commercial --output ml/data/simulation-v1",
    "ml:validate:simulation": "python3 -m ml.validate_simulation --output ml/data/simulation-v1",
    "db:import:simulation:staging": "node scripts/import-simulation-staging.mjs --target staging --output ml/data/simulation-v1",
    "db:reconcile:simulation:staging": "node scripts/import-simulation-staging.mjs --target staging --output ml/data/simulation-v1 --reconcile",
    "db:import:simulation:production": "DOTENV_CONFIG_PATH=.env.local node --import dotenv/config scripts/import-simulation-staging.mjs --target production --output ml/data/simulation-v1",
    "test:simulation-importer": "node --test scripts/import-simulation-staging.test.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
