{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "apf-service",
          "format": "url",
          "env": "APF3_SERVICE_URL"
        }
      ]
    },
    "apf-service": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "python.app:app",
      "functions": {
        "python/**/*.py": {
          "maxDuration": 30,
          "excludeFiles": "{python/tests/**,ml/{data,tests}/**,ml/train*.py,ml/artifacts/**/*.{png,csv},ml/artifacts/**/forecast-batch/**,**/{.venv,.next,.vercel,__pycache__,.pytest_cache}/**,**/{__tests__,tests,test,testing}/**,**/pip*/**,**/*.{pyc,pyo,pyi,md}}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
