{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "apf3",
          "format": "url",
          "env": "APF3_SERVICE_URL"
        }
      ]
    },
    "apf3": {
      "root": "python",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 30,
          "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,ml/data/**,ml/tests/**,ml/train*.py,ml/artifacts/**/*.png,ml/artifacts/**/*.csv,ml/artifacts/**/forecast-batch/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
