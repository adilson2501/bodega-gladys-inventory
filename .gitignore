# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python ML workspace
__pycache__/
*.py[cod]
ml/data/

# Ignorar artefactos ML por defecto
ml/artifacts/*

# Permitir artefactos APF3 necesarios para la aplicación
!ml/artifacts/apf3/
ml/artifacts/apf3/*
!ml/artifacts/apf3/model_metadata.json
!ml/artifacts/apf3/model.joblib
!ml/artifacts/apf3/model_selection.json
!ml/artifacts/apf3/tuning_results.json
!ml/artifacts/apf3/evaluation_metrics.json
!ml/artifacts/apf3/error_analysis.json
!ml/artifacts/apf3/inference_example.json
!ml/artifacts/apf3/temporal_split.json
!ml/artifacts/apf3/future_inference_output.json
!ml/artifacts/apf3/replenishment_recommendation.json
!ml/artifacts/apf3/phase_e1_audit.json

# Python virtual environment
.venv/
