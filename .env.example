# PostgreSQL connection string for the Neon main branch.
DATABASE_URL=

# Neon Auth URL from the Neon Console.
NEON_AUTH_BASE_URL=

# Generate locally with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# One-time secret required to create the first administrator. Generate it locally
# with: openssl rand -base64 32
BOOTSTRAP_ADMIN_TOKEN=
