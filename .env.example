# PostgreSQL connection string for the Neon main branch.
DATABASE_URL=

# Expected Neon Production identity. The verification command fails closed if
# DATABASE_URL points anywhere else.
PRODUCTION_NEON_ENDPOINT_HOST=
PRODUCTION_NEON_ENDPOINT_ID=
PRODUCTION_NEON_DATABASE_NAME=

# Neon Auth URL from the Neon Console.
NEON_AUTH_BASE_URL=

# Generate locally with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# One-time secret required to create the first administrator. Generate it locally
# with: openssl rand -base64 32
BOOTSTRAP_ADMIN_TOKEN=

# Development-only hostnames, comma-separated. Do not use wildcards.
DEV_ALLOWED_ORIGINS=

# Server Action hosts, including the port when the origin uses one.
DEV_SERVER_ACTION_ALLOWED_ORIGINS=
# Local FastAPI service URL. Vercel injects this through the private binding.
APF3_SERVICE_URL=http://127.0.0.1:8000

# Shared only by the Next.js server and the private APF3 service.
APF3_INTERNAL_SECRET=
